{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "npm run build && tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:edge": "vitest run --project edge",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx scripts/init-firestore.ts",
    "db:init-db": "tsx scripts/init-db.ts",
    "lint": "tsc --noEmit && echo 'No lint errors'"
  },
  "dependencies": {
    "@types/d3": "^7.4.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "d3": "^7.9.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "firebase": "^12.17.0",
    "framer-motion": "^12.38.0",
    "hono": "^4.13.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^6.2.108",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.10.1",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@hono/node-server": "^2.0.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^4.1.10",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.4",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "wrangler": "^4.128.0"
  }
}
